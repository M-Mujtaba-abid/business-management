# Copy to .env and fill in. Generate secrets with:  openssl rand -hex 32

# The app calls wa-service with this (same value as WA_API_SECRET in the Next.js app)
WA_API_SECRET=

# Where results and customer replies are sent, and the key that signs them
# (same value as WA_WEBHOOK_SECRET in the Next.js app)
# WA_WEBHOOK_URL=https://your-app.vercel.app/api/whatsapp/webhook

WA_WEBHOOK_URL=http://host.docker.internal:3000/api/whatsapp/webhook

WA_WEBHOOK_SECRET=

# Random gap between two messages, in seconds (anti-ban). Keep it slow.
WA_MIN_GAP_SECONDS=20
WA_MAX_GAP_SECONDS=60

# Automatic order messages are held back at night (hours on the shop clock, 22 → 9)
# and reach at most this many different customers a day; the rest go next morning.
# Replies to a customer and bills sent by hand go out any time.
WA_TIMEZONE=Asia/Karachi
WA_QUIET_START=22
WA_QUIET_END=9
WA_DAILY_NEW_CHATS=150

# Session store: SQLite in the /data volume (default), or Postgres
# WA_DB_DIALECT=postgres
# WA_DB_ADDRESS=postgres://user:pass@host/whatsapp?sslmode=require

LOG_LEVEL=info
