generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Neon direct (non-pooler) connection, used by prisma migrate
}

enum ExpenseCategory {
  MARKETING_ADS
  PACKAGING
  COURIER_BILL
  LOGISTICS
  UTILITIES
  MISC
}

enum FundingSource {
  BUSINESS_PROFIT
  PERSONAL_CAPITAL
  CREDIT_SUPPLIER
}

enum OrderStatus {
  PACKING
  DISPATCHED
  DELIVERED
  RETURNED
  CANCELLED
}

enum SupplierPayment {
  PENDING
  PAID
  NOT_APPLICABLE
}

enum CustomerPayment {
  NOT_RECEIVED
  RECEIVED
  NOT_APPLICABLE
}

// Who did something to an order (order history)
enum LogSource {
  USER      // someone logged in to the app
  LEOPARDS  // Leopards push / our Leopards check
  WHATSAPP  // WhatsApp service (message sent / failed)
  CUSTOMER  // the customer (WhatsApp reply / vote)
  SYSTEM    // the app itself (automatic rules, history filled in from older records)
}

// Asking a delivered order's customer for a review (call them, then note what happened)
enum ReviewStatus {
  NONE      // not delivered (nothing to ask yet)
  PENDING   // delivered, nobody has called yet
  CALLED    // called the customer and asked for a review
  REVIEWED  // the customer wrote the review
  DECLINED  // no answer / did not want to review
}

// Customer's WhatsApp reply to the "confirm your order" message
enum CustomerResponse {
  NONE
  PENDING
  CONFIRMED
  CANCELLED
}

enum WhatsAppKind {
  ORDER_CONFIRM
  DISPATCHED
  DELIVERED
  REPLY_ACK
  BILL // the order's bill image, sent from the Bill window
  ANSWER_LOCKED // once per order: "your first answer is saved" when the customer tries to change it
}

enum WhatsAppStatus {
  PENDING
  SENT
  FAILED
}

enum ReturnedItemStatus {
  AVAILABLE
  USED
}

model Expense {
  id            String          @id @default(cuid())
  title         String          @default("General Expense")
  amount        Float
  category      ExpenseCategory @default(MISC)
  fundingSource FundingSource   @default(BUSINESS_PROFIT)
  partnerId     String?
  note          String?
  paidById      String?
  createdAt     DateTime        @default(now())

  partner       Partner?        @relation(fields: [partnerId], references: [id])
  paidBy        Person?         @relation(fields: [paidById], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([category])
  @@index([paidById])
}

model Partner {
  id                   String              @id @default(cuid())
  name                 String              // e.g. "Noman", "Mujtaba"
  totalCapitalInvested Float               @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  purchases            InventoryPurchase[]
  expenses             Expense[]
}

model Product {
  id          String   @id @default(cuid())
  name        String   @unique
  costPrice   Float
  salePrice   Float
  stockQty    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases   InventoryPurchase[]
  sales       Sale[]
}

model Supplier {
  id            String              @id @default(cuid())
  name          String
  phone         String?
  unpaidBalance Float               @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  purchases      InventoryPurchase[]
  sales          Sale[]
  inventoryItems InventoryItem[]
  stockPurchases StockPurchase[]
}

model Category {
  id            String         @id @default(cuid())
  name          String         @unique
  createdAt     DateTime       @default(now())

  sales          Sale[]
  returnedItems  ReturnedItem[]
  inventoryItems InventoryItem[]
}

// Person whose account the order money lands in (Mujtaba, Noman, ...)
model Person {
  id          String       @id @default(cuid())
  name        String       @unique
  createdAt   DateTime     @default(now())

  sales       Sale[]       @relation("ReceivedBy")
  dcSales     Sale[]       @relation("DcPaidBy")
  supplierPaidSales Sale[] @relation("SupplierPaidBy")
  transfersOut MoneyTransfer[] @relation("TransferFrom")
  transfersIn  MoneyTransfer[] @relation("TransferTo")
  expenses    Expense[]
  withdrawals Withdrawal[]
  users       User[]
  stockPayments StockPayment[]
  bankChecks  BankCheck[]
  moneyEntries MoneyEntry[]
  leopardsInvoices LeopardsInvoice[]
}

// One Leopards payment (invoice / cheque), from Leopards' getInvoices. Its amount is exactly what
// reaches the bank. Leopards takes a parcel's charges in one invoice (often before delivery) and pays
// its COD (minus tax) in a later one, so an invoice = COD − tax of some orders − charges of others.
// receivedAt: when the money reached us — set with "Money received" in the app, or automatically when
// Leopards says it is paid. Its orders are then marked Received (lib/leopardsMoney.ts).
model LeopardsInvoice {
  invoiceNo      String    @id
  invoiceDate    DateTime?
  amount         Float
  bankName       String?
  method         String?   // e.g. IBFT
  leopardsStatus String?   // Leopards' own word, e.g. "processing"
  receivedAt     DateTime?
  receivedById   String?
  markedBy       String?   // who clicked "Money received" (null = Leopards said paid)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  receivedBy     Person?   @relation(fields: [receivedById], references: [id], onDelete: SetNull)

  @@index([receivedById])
}

// Bank check (reconciliation): the real balance in the person's business bank account on a date,
// compared with their In hand in the app at that moment. difference = bankBalance - inHand
// (0 = everything matches). Accounts hold business money only, so they should always be equal.
model BankCheck {
  id           String   @id @default(cuid())
  personId     String
  bankName     String   // e.g. Meezan, Mashreq
  bankBalance  Float
  inHand       Float    // the app's In hand when checked
  difference   Float
  note         String?
  createdBy    String?
  createdAt    DateTime @default(now())

  person       Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, createdAt])
}

// Someone who can log in to the app. Passwords are stored only as a scrypt hash
// ("scrypt$<salt hex>$<hash hex>"); create / change them with scripts/set-user.js.
model User {
  id           String    @id @default(cuid())
  email        String    @unique // stored lower-case
  name         String
  passwordHash String
  personId     String? // the money person this login belongs to (optional)
  person       Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)
  // Goes up when the password changes: every login made before that stops working
  sessionVersion Int     @default(1)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Money a person takes out of the business money they hold
// PROFIT = taking business money for yourself; CAPITAL = taking back money you invested
enum WithdrawalType {
  PROFIT
  CAPITAL
}

model Withdrawal {
  id        String         @id @default(cuid())
  personId  String
  amount    Float
  reason    String?
  type      WithdrawalType @default(PROFIT)
  createdAt DateTime       @default(now())

  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@index([createdAt])
}

// Money added to (or corrected in) a person's In hand that is not an order, expense or withdrawal:
//  OPENING    – what was already in their business account when the app started (one per person)
//  INVESTMENT – their own personal money put into the business (also counts as their capital)
//  ADJUSTMENT – a correction with a reason (bank profit, fee, unexplained difference); + or −
enum MoneyEntryKind {
  OPENING
  INVESTMENT
  ADJUSTMENT
}

model MoneyEntry {
  id         String         @id @default(cuid())
  personId   String
  kind       MoneyEntryKind
  amount     Float          // + adds to In hand, − takes from it (only ADJUSTMENT can be negative)
  date       DateTime       // when it happened (opening: the first order's date)
  note       String?
  createdBy  String?
  createdAt  DateTime       @default(now())

  person     Person         @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, date])
}

// Where the order came from (Daraz, Website, OLX, Marketplace, ...)
model OrderSource {
  id        String   @id @default(cuid())
  name      String   @unique
  // Send WhatsApp messages / bills to customers of this source? (off for Daraz: the marketplace
  // does not allow contacting its customers outside Daraz)
  whatsappEnabled Boolean @default(true)
  createdAt DateTime @default(now())

  sales     Sale[]
}

// Who pays us for an order (Daraz, Leopards courier COD, ...)
model PaymentSource {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  sales     Sale[]
}

model ReturnedItem {
  id           String             @id @default(cuid())
  productName  String
  categoryId   String?
  costPrice    Float              @default(0)
  quantity     Int                @default(1)
  sourceSaleId String
  usedInSaleId String?
  status       ReturnedItemStatus @default(AVAILABLE)
  createdAt    DateTime           @default(now())

  category     Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([sourceSaleId])
}

model InventoryPurchase {
  id            String        @id @default(cuid())
  productId     String
  quantity      Int
  unitCost      Float
  totalCost     Float
  fundingSource FundingSource
  partnerId     String?
  supplierId    String?
  createdAt     DateTime      @default(now())

  product       Product       @relation(fields: [productId], references: [id])
  partner       Partner?      @relation(fields: [partnerId], references: [id])
  supplier      Supplier?     @relation(fields: [supplierId], references: [id])
}

model Sale {
  id                     String      @id @default(cuid())
  productId              String?
  productName            String
  customerName           String
  customerPhone          String?
  address                String
  city                   String      @default("General")
  quantity               Int         @default(1)
  costPrice              Float       @default(0)
  soldPrice              Float
  deliveryCharge         Float       @default(0)
  profit                 Float       @default(0)
  status                 OrderStatus @default(DISPATCHED)
  deductDeliveryOnReturn Boolean     @default(true)
  categoryId             String?
  supplierId             String?
  petrolCost             Float       @default(0)
  gstAmount              Float       @default(0)
  returnLoss             Float       @default(0)
  returnedItemId         String?
  supplierPaymentStatus  SupplierPayment @default(PENDING)
  supplierPaidAt         DateTime?
  // who paid the supplier (their In hand goes down); null on older orders = paid from the order money
  supplierPaidById       String?
  paymentSourceId        String?
  orderSourceId          String?
  receivedById           String?
  // Person whose account the delivery charge was paid from (null = not tracked)
  dcPaidById             String?
  paymentStatus         CustomerPayment @default(NOT_RECEIVED)
  paymentReceivedAt      DateTime?
  // Actual (or expected, until received) payout for the order; null = full sale amount
  receivedAmount         Float?
  // Products bought together by one customer share a parcelId (null = single-product order)
  parcelId               String?
  // Our own short order number (#1001...), shared by a parcel's products
  orderNo                Int?
  // Daraz / Website order ID, and the courier (Leopards...) tracking number
  externalOrderId        String?
  trackingNumber         String?
  // Customer's WhatsApp confirm / cancel reply (shared by a parcel's products)
  customerResponse       CustomerResponse @default(NONE)
  customerRespondedAt    DateTime?
  // Returned orders: when it was marked Returned (courier status), and whether the parcel
  // has physically come back to us yet (it usually arrives a few days later)
  returnedAt             DateTime?
  returnReceived         Boolean     @default(false)
  returnReceivedAt       DateTime?
  // Latest courier (Leopards) status, pushed by Leopards to /api/leopards/push (shared by a parcel's products)
  courierStatus          String?
  courierStatusCode      String?
  courierReason          String?
  courierStatusAt        DateTime?
  // Leopards money for the whole parcel (from Leopards' getShippingCharges + getPaymentDetails):
  //   courierCod      cash Leopards collected from the customer
  //   courierCharges  everything Leopards deducts (delivery, GST, fuel, ...)
  //   courierPayout   courierCod - courierCharges = what Leopards pays us
  //   courierPayment  NOT_INVOICED | PENDING (invoice made, not paid) | PAID | Leopards' own word
  //   courierMoney    the full breakdown + invoice no / date / method, for the popup
  courierCod             Float?
  courierCharges         Float?
  courierPayout          Float?
  courierPayment         String?
  courierMoney           Json?
  courierMoneyAt         DateTime?
  // Leopards invoice that pays this order's COD (null = not paid in an invoice yet)
  courierInvoiceNo       String?
  // true = receivedAmount / return loss are kept in step with Leopards automatically
  // (COD − tax − charges); false once someone types the amount by hand
  courierMoneyAuto       Boolean     @default(false)
  // Booked with Leopards from the app (Book Leopards button): label link (kept on the server; it can
  // carry account details, so the browser gets it through /api/sales/[id]/leopards/slip) and when
  courierSlipUrl         String?
  courierBookedAt        DateTime?
  // Review follow-up (shared by a parcel's products). Becomes PENDING when the order is delivered.
  reviewStatus           ReviewStatus @default(NONE)
  reviewStatusAt         DateTime?
  // Sold from our own stock (Inventory page). inventoryHeld = the stock is currently taken out for this
  // row (false once given back on cancel / return / delete), so stock is never given back twice.
  inventoryItemId        String?
  inventoryHeld          Boolean     @default(false)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  product                Product?    @relation(fields: [productId], references: [id])
  inventoryItem          InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  category               Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier               Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  paymentSource          PaymentSource? @relation(fields: [paymentSourceId], references: [id], onDelete: SetNull)
  orderSource            OrderSource?   @relation(fields: [orderSourceId], references: [id], onDelete: SetNull)
  receivedBy             Person?        @relation("ReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  dcPaidBy               Person?        @relation("DcPaidBy", fields: [dcPaidById], references: [id], onDelete: SetNull)
  supplierPaidBy         Person?        @relation("SupplierPaidBy", fields: [supplierPaidById], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([city])
  @@index([status])
  @@index([status, returnReceived])
  @@index([reviewStatus])
  @@index([categoryId])
  @@index([supplierId])
  @@index([supplierPaymentStatus])
  @@index([paymentSourceId])
  @@index([paymentStatus])
  @@index([orderSourceId])
  @@index([receivedById])
  @@index([dcPaidById])
  @@index([inventoryItemId])
  @@index([parcelId])
  @@index([orderNo])
  @@index([externalOrderId])
  @@index([trackingNumber])
  @@index([courierInvoiceNo])
  @@index([customerResponse])
}

// WhatsApp messages sent to customers (one per order + kind, so a status change never sends twice)
model WhatsAppMessage {
  id          String         @id @default(cuid())
  orderNo     Int
  phone       String
  kind        WhatsAppKind
  body        String
  status      WhatsAppStatus @default(PENDING)
  // WhatsApp message id, used to match a customer's quoted reply to this order
  waMessageId String?        @unique
  error       String?
  attempts    Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  sentAt      DateTime?
  // Held back by quiet hours / the daily limit: when wa-service will send it
  scheduledFor DateTime?

  @@unique([orderNo, kind])
  @@index([phone])
}

// Editable wording of each automatic WhatsApp message (key = ORDER_CONFIRM, DISPATCHED, DELIVERED,
// REPLY_CONFIRMED, REPLY_CANCELLED). No row = the built-in default text in lib/whatsapp.ts.
model WhatsAppTemplate {
  key         String   @id
  body        String
  // More wordings of the same message; each send picks one at random (anti-spam)
  variants    String[] @default([])
  // Wording used last time, so the next customer gets a different one
  lastVariant Int      @default(-1)
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

// Customers who replied STOP: they get no automatic messages until they reply START
model WhatsAppOptOut {
  phone     String   @id
  createdAt DateTime @default(now())
}

enum ChatDirection {
  IN
  OUT
}

// Full conversation with each customer, shown in the order's Chat window
model WhatsAppChat {
  id          String        @id @default(cuid())
  phone       String
  direction   ChatDirection
  body        String
  orderNo     Int?
  // true = typed on the business phone (not sent automatically)
  manual      Boolean       @default(false)
  waMessageId String?       @unique
  createdAt   DateTime      @default(now())

  @@index([phone, createdAt])
}

// Atomic counters (e.g. the next order number)
model Counter {
  key   String @id
  value Int
}

model CityDeliveryRate {
  id          String   @id @default(cuid())
  cityName    String   @unique
  deliveryFee Float
  updatedAt   DateTime @updatedAt
}

// Optional photos of an order (stored on Cloudinary; a parcel's photos share its order number)
model OrderImage {
  id        String   @id @default(cuid())
  orderNo   Int
  url       String
  publicId  String
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([orderNo])
}

// Simple app-wide switches (e.g. "whatsapp.enabled" = "true" / "false")
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Order history: one line per thing that happened to an order, by hand or automatically.
// Kept when an order is deleted (orderNo / saleId are plain values, not relations).
model OrderLog {
  id        String    @id @default(cuid())
  orderNo   Int?      // the order (all products of a parcel share it)
  saleId    String?   // lead product row, for older orders without an order number
  action    String    // short code, e.g. created, status, payment, leopards_status, whatsapp_sent
  message   String    // what happened, in words
  source    LogSource
  actor     String?   // who: user name, "Leopards", "WhatsApp", customer name...
  details   Json?     // before / after values and other facts
  createdAt DateTime  @default(now())

  @@index([orderNo, createdAt])
  @@index([saleId])
  @@index([createdAt])
}

// ── Inventory: our own stock (bought, kept, then sold from the order form "From inventory") ──

// One thing we keep in stock. avgCost = weighted average buy price of what is in stock.
model InventoryItem {
  id          String    @id @default(cuid())
  name        String
  categoryId  String?
  supplierId  String?   // usual supplier (each purchase can still name its own)
  stockQty    Int       @default(0)
  avgCost     Float     @default(0)
  salePrice   Float?    // usual selling price, pre-filled in the order form
  lowStockAt  Int?      // warn when stock is at or below this
  active      Boolean   @default(true) // false = archived (hidden)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier    Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchases   StockPurchase[]
  logs        InventoryLog[]
  sales       Sale[]

  @@index([active])
  @@index([name])
}

// Buying stock: who paid, and whether it came from business money (in hand) or personal savings
enum StockPaymentKind {
  BUSINESS // from the person's business money in hand (lowers their In hand)
  SAVINGS  // from the person's own savings: an investment in the business
}

model StockPurchase {
  id          String    @id @default(cuid())
  itemId      String
  quantity    Int
  unitCost    Float
  totalCost   Float
  supplierId  String?
  note        String?
  createdBy   String?   // user name
  createdAt   DateTime  @default(now())

  item        InventoryItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  supplier    Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  payments    StockPayment[]

  @@index([itemId])
  @@index([createdAt])
}

model StockPayment {
  id          String           @id @default(cuid())
  purchaseId  String
  personId    String
  amount      Float
  kind        StockPaymentKind
  createdAt   DateTime         @default(now())

  purchase    StockPurchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  person      Person           @relation(fields: [personId], references: [id])

  @@index([personId])
  @@index([purchaseId])
}

// Every stock movement of an item: bought, sold, given back, adjusted, edited
model InventoryLog {
  id          String     @id @default(cuid())
  itemId      String
  action      String     // created | stock_in | sold | released | returned_back | adjusted | edited | archived
  qtyChange   Int        @default(0)
  qtyAfter    Int
  unitCost    Float?
  amount      Float?
  orderNo     Int?
  saleId      String?
  purchaseId  String?
  message     String
  source      LogSource
  actor       String?
  details     Json?
  createdAt   DateTime   @default(now())

  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
  @@index([createdAt])
  @@index([orderNo])
}

// Money sent from one person to another (e.g. Noman → Mujtaba, Meezan → Mashreq).
// supplierPart: how much of it is supplier money (cover cost still to pay), so each person's
// "supplier money / own money" split stays right after the transfer.
model MoneyTransfer {
  id           String   @id @default(cuid())
  fromId       String
  toId         String
  amount       Float
  supplierPart Float    @default(0)
  date         DateTime
  note         String?
  createdBy    String?
  createdAt    DateTime @default(now())

  from         Person   @relation("TransferFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to           Person   @relation("TransferTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([fromId, date])
  @@index([toId, date])
}
